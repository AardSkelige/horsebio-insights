DEBUG=True
SECRET_KEY=change-me
MOYSKLAD_TOKEN=change-me          # horsebio МойСклад токен
STARPONY_MOYSKLAD_TOKEN=change-me # starpony МойСклад токен
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001

# PostgreSQL (for Docker)
POSTGRES_DB=horsebio_db
POSTGRES_USER=horsebio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db

# OZON (optional)
OZON_API_KEY=change-me
OZON_CLIENT_ID=change-me
OZON_AD_CLIENT_ID=change-me
OZON_AD_CLIENT_SECRET=change-me

# OZON Доставка (Ozon Логистика) — частное приложение «OZON Доставка Horse-Bio», OAuth.
# ЛК продавца → Настройки → Приложения и разрешения → ключ у приложения.
# Скоупы приложения (7, как отмечено в ЛК; менять их там — повторная модерация):
#   ozon-logistics, posting-fbs, warehouse, notification, product, returns, report.
# Тот же список продублирован в ozon_logistics/services/oauth.py::SCOPES.
OZON_LOGISTICS_CLIENT_ID=change-me
OZON_LOGISTICS_CLIENT_SECRET=change-me
OZON_LOGISTICS_REDIRECT_URI=http://insight.horse-bio.ru/api/ozon-logistics/oauth/callback

# Почта уведомлений о заказах (Megagroup CMS)
ORDER_MAIL_IMAP_HOST=imap.mail.ru
ORDER_MAIL_IMAP_USER=change-me
ORDER_MAIL_IMAP_PASSWORD=change-me

# СДЭК — создание накладных (логин/пароль интеграции из ЛК СДЭК)
CDEK_CLIENT_ID=change-me
CDEK_CLIENT_SECRET=change-me
CDEK_ENV=test                      # test = api.edu.cdek.ru, prod = api.cdek.ru

# Обмен с сайтом horse-bio.ru (CommerceML) — карточки, цены, остатки, снятие с продажи.
# Логин и пароль берутся в админке: Магазин → Импорт → CommerceML → Подключение.
# Обмен применяет цены и остатки только при включённом тумблере
# «Автоматический импорт товаров» во вкладке Автоимпорт.
SITE_CML_LOGIN=change-me
SITE_CML_PASSWORD=change-me
SITE_CML_URL=https://horse-bio.ru/-/api/cml/v2/
