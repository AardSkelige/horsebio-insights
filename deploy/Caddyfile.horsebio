# Блок Horse Bio Insights для общего Caddyfile.
#
# Caddy на сервере один на два проекта (второй — StarPony Insights), и его
# конфигурация живёт в /root/caddy/Caddyfile. Деплой её не копирует: здесь
# лежит копия нашей части, чтобы её можно было прочитать, не заходя
# на сервер, и восстановить, если конфигурация на сервере потеряется.
#
# Применение:
#   docker exec shared_caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec shared_caddy caddy reload   --config /etc/caddy/Caddyfile --adapter caddyfile
# Публикация портов и монтирование томов — в /root/caddy/docker-compose.caddy.yml.
# Их изменение требует пересоздания контейнера, reload не подхватит ни то, ни другое.
#
# Тома: /srv/horsebio — собранный фронтенд (наполняет деплой фронта),
# /srv/horsebio-django — статика админки (её кладёт collectstatic бэкенда),
# /srv/horsebio-zakaz — бланк заказа для контрагентов: обычный каталог
# на хосте, файл туда кладётся через scp (см. «Бланк заказа/deploy/»).

{
	email mystmuse@gmail.com

	# Порт 80 занимаем: с 02.09.2026 контейнер Horse Bio его больше
	# не публикует, и голый http:// перестал отвечать вовсе — старая
	# закладка упиралась в отказ соединения. Теперь Caddy отвечает на 80
	# и уводит на 443 своим редиректом.
}

insight.horse-bio.ru {
	# HSTS НЕ включаем: откат должен оставаться мгновенным.

	# API, парсер и админка — прямо в gunicorn. До 06.09.2026 между Caddy
	# и Django стояли два nginx, которые только перекладывали запрос дальше:
	# сначала фронтовый, потом бэкендовый.
	@backend path /api/* /parser/* /admin/*
	handle @backend {
		reverse_proxy horsebio_backend:8000 {
			# Долгие операции: прогноз и ABC-анализ считаются прямо в запросе.
			# Столько же ждёт и gunicorn, дальше него ждать некому.
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	# Статика админки Django: её складывает collectstatic при старте бэкенда.
	# Приставка /static/ свободна — собранные файлы фронта лежат в /assets/.
	handle_path /static/* {
		root * /srv/horsebio-django
		file_server
	}

	# Бланк заказа для контрагентов: статическая страница под паролем.
	# Ставить ВЫШЕ общего `handle` с одностраничным приложением, иначе
	# try_files отдаст index.html фронтенда и до файла дело не дойдёт.
	handle_path /zakaz* {
		basic_auth {
			# bcrypt-хеш; сам пароль — в «Бланк заказа/deploy/README.md»
			partner <хеш из caddy hash-password>
		}

		# Страница не для поиска: её находят только по присланной ссылке.
		header X-Robots-Tag "noindex, nofollow"

		# Файл один и меняется при обновлении цен — кэшировать нечего.
		header Cache-Control "no-store"

		root * /srv/horsebio-zakaz
		try_files {path} /index.html
		file_server
	}

	# Всё остальное — одностраничное приложение.
	handle {
		root * /srv/horsebio

		# Имена собранных файлов содержат хеш содержимого: меняется файл —
		# меняется имя. Поэтому их можно кэшировать надолго.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# А index.html — никогда: он единственный со стабильным именем,
		# и закэшированный им браузер будет вечно просить файлы прошлой сборки.
		@index path / /index.html
		header @index Cache-Control "no-store"

		# Маршруты приложения живут на клиенте: /checks, /purchases и прочие
		# файлами на диске не являются.
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
